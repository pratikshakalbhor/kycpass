# ===== KYCPass environment =====
# Copy to `.env` and adjust. `.env` is gitignored — never commit secrets.

# Network: `local` (docker compose devnet, default) or `preview` (public Preview).
NETWORK=local

# Midnight node / indexer / proof-server endpoints.
# Preview defaults (uncomment to target Preview):
#   MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
#   MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network
#   MIDNIGHT_PROOF_SERVER_URL=https://proof-server.preview.midnight.network
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_INDEXER_URL=http://localhost:8088
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Deployed contract address, returned by the DApp Connector when the frontend
# deploys the contract. Used by the frontend to locate the ledger.
VITE_CONTRACT_ADDRESS=

# Frontend network target and indexer URL (read by Vite from the env dir).
VITE_NETWORK=preview
VITE_INDEXER_URL=https://indexer.preview.midnight.network

# ----------------------------------------------------------------
# Demo-authenticator credentials (demo frontend only).
# In production these live in the wallet, never in a file.
# ----------------------------------------------------------------
ISSUER_PRIVATE_KEY=
VERIFIER_PORT=3001